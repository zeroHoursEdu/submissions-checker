// Submissions Checker → Prometheus remote_write.
//
// Push, not pull: the production host publishes nothing but Caddy, and Grafana Cloud has no
// route to a compose network. Alloy scrapes the app replicas over that network and writes
// outbound. Locally the same file writes into a throwaway Prometheus, so the config that
// reaches production is the one that was exercised on the laptop.
//
// Every value comes from the environment; nothing secret is in this file.

discovery.dns "app" {
	// Docker's embedded DNS answers a compose service name with every replica's address,
	// so one name finds both production replicas and the single local container alike.
	names            = [coalesce(sys.env("APP_METRICS_HOST"), "app")]
	type             = "A"
	port             = 8000
	refresh_interval = "15s"
}

prometheus.scrape "app" {
	targets         = discovery.dns.app.targets
	job_name        = "submissions-checker"
	metrics_path    = "/metrics"
	scrape_interval = "30s"
	scrape_timeout  = "10s"
	forward_to      = [prometheus.remote_write.out.receiver]
}

prometheus.remote_write "out" {
	// Labels every series with where it came from, so a laptop run and production never
	// average into each other on the same dashboard.
	external_labels = {
		env = coalesce(sys.env("SUBCHK_ENV"), "local"),
	}

	endpoint {
		url = sys.env("GRAFANA_CLOUD_PROM_URL")

		basic_auth {
			// Grafana Cloud: username is the numeric Prometheus instance id, password an
			// access-policy token with metrics:write. Locally both are dummy values.
			username = sys.env("GRAFANA_CLOUD_PROM_USER")
			password = sys.env("GRAFANA_CLOUD_PROM_TOKEN")
		}
	}
}

// ── Logs → Loki ─────────────────────────────────────────────────────────────
//
// Tails every container of this compose project through the Docker socket (read-only
// mount). Only four labels: app, service, env and level; ids stay in the JSON line and are
// read with `| json` at query time, which keeps the free tier's stream count tiny.

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"

	filter {
		name   = "label"
		values = ["com.docker.compose.project=" + coalesce(sys.env("SUBCHK_COMPOSE_PROJECT"), "submissions-checker")]
	}
}

discovery.relabel "containers" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.containers.targets
	relabel_rules = discovery.relabel.containers.rules
	labels        = {
		app = "subchk",
		env = coalesce(sys.env("SUBCHK_ENV"), "local"),
	}
	forward_to = [loki.process.levels.receiver]
}

loki.process "levels" {
	// app and caddy log JSON with a `level` key; other lines (postgres) pass through as-is.
	stage.json {
		expressions = {level = ""}
	}

	stage.labels {
		values = {level = ""}
	}

	forward_to = [loki.write.out.receiver]
}

loki.write "out" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_LOKI_URL")

		basic_auth {
			// Grafana Cloud: username is the numeric Loki user id, password an access-policy
			// token with logs:write. The local Loki ignores both.
			username = sys.env("GRAFANA_CLOUD_LOKI_USER")
			password = sys.env("GRAFANA_CLOUD_LOKI_TOKEN")
		}
	}
}
