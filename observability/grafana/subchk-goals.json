{
  "uid": "subchk-goals",
  "title": "Submissions Checker — Goals",
  "tags": [
    "subchk"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(max by (revision) (app_info{job=\"submissions-checker\"})[5m:1m]) > 0",
        "titleFormat": "deploy {{revision}}",
        "step": "1m"
      }
    ]
  },
  "panels": [
