      "type": "row",
      "title": "Students",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Students",
      "description": "Real students with an account (test entities excluded). The denominator for every adoption question below.",
