# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/submissions_checker
# For local development outside Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/submissions_checker

# AI Provider Settings
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# Scheduler Settings
SCHEDULER_ENABLED=true

# Outbox Settings
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=10
OUTBOX_MAX_RETRIES=5
OUTBOX_RETRY_BACKOFF_SECONDS=60

# API Settings
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Air-raid pause during a quiz. Request a token at https://alerts.in.ua/api-request
# (they email it to you); API docs at https://devs.alerts.in.ua.
# Without a token the button reports that the check is unavailable and NO attempt is ever
# paused — an unverified claim must not stop a graded clock.
# Note the browser only exposes geolocation on a secure context, so the pause button does
# nothing over plain HTTP other than localhost. Serve the app over HTTPS.
ALERTS_IN_UA_TOKEN=
ALERTS_IN_UA_BASE_URL=https://api.alerts.in.ua
AIR_RAID_PAUSE_ENABLED=true
# Upstream rate limit is ~12 requests/minute per IP; responses are cached this long.
AIR_RAID_CACHE_SECONDS=30

# --- Observability (see docs/observability.md) -------------------------------
# `make observability-up` needs none of these: the local Alloy pushes into the local
# Prometheus. They are for pushing the committed dashboards and alert rules to Grafana
# Cloud from this machine. GRAFANA_URL is the stack URL; GRAFANA_API_TOKEN is a service
# account token with the Editor role (Administration -> Users and access -> Service accounts).
GRAFANA_URL=https://charmingaphid2632.grafana.net
GRAFANA_API_TOKEN=
# Telegram contact point for alerts: a bot token from @BotFather and the chat id the bot
# should post to (send the bot a message, then read chat.id from
# https://api.telegram.org/bot<TOKEN>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
