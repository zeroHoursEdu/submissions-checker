# Production environment for docker-compose.prod.yml.
#
# Copy to `.env` ON THE HOST ONLY and fill in every value. Never commit the result.
#
#   cp .env.prod.example .env && chmod 600 .env
#
# Every variable below is required unless marked optional. The stack refuses to start
# with a missing required value rather than booting in a half-configured state.

# --- Public identity ---------------------------------------------------------
# Must already resolve to this host: Caddy proves control of it to get a certificate.
DOMAIN=submissions.example.edu
# Let's Encrypt uses this only for expiry notices.
ACME_EMAIL=admin@example.edu

# --- Application secrets -----------------------------------------------------
# Generate: openssl rand -hex 32
# Changing this invalidates every existing login session.
SECRET_KEY=

# --- Database ----------------------------------------------------------------
POSTGRES_USER=submissions
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=submissions_checker
# Host-side port for the loopback-only binding, for connecting a database client over
# an SSH tunnel (see docs/deployment.md). Change it only if 5432 is already taken on
# the host; the bind address is always 127.0.0.1 and is not configurable.
POSTGRES_HOST_PORT=5432
# replicas * (DB_POOL_SIZE + DB_MAX_OVERFLOW) must stay under postgres max_connections
# (30, set in the compose file), leaving room for migrations and the backup job.
# Defaults: 2 replicas * (4 + 4) = 16.
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=4

# --- Object storage (MinIO, internal only) -----------------------------------
MINIO_ROOT_USER=submissions
# Generate: openssl rand -hex 24
MINIO_ROOT_PASSWORD=
S3_BUCKET_NAME=submissions-checker
AWS_REGION=us-east-1

# --- Host integration --------------------------------------------------------
# The host's docker group id, so the app can reach the socket without running as root.
# Find it with: getent group docker | cut -d: -f3
DOCKER_GID=
# Legacy fallback only. Subject config trees now live in Postgres
# (subject_plugin_configs.zip_data) and are unpacked on demand into PLUGIN_CACHE_DIR
# (/tmp/subchk-plugins, already wired in the compose file — nothing to set here).
#
# EXISTING host, upgrading to this release: if any subject's config was applied before
# migration 0018 (still served from a plugins/ tree on disk, never stored in Postgres),
# this MUST stay set to its current absolute path until you have re-applied every such
# subject's config through the teacher portal (tracked by `migrate_uploads`; removed in
# phase 2). Emptying it disables the legacy fallback outright — those subjects' checks
# then fail with "no stored archive" until re-applied. It must be host-absolute (the
# Docker daemon resolves sandbox bind mounts on the host, not inside the container) —
# the bare `plugins` default below is relative and is NOT a working fallback, it only
# means "no legacy tree configured". Must also be writable by uid 10001, the
# unprivileged user the app image runs as:
#   sudo mkdir -p /opt/submissions-checker/plugins
#   sudo chown -R 10001:10001 /opt/submissions-checker/plugins
#
# FRESH host, no pre-0018 subjects: leave unset (defaults to ./plugins, unused).
HOST_PLUGINS_DIR=

# --- Image and rollout -------------------------------------------------------
# Published by .github/workflows/app-image.yml. Replace OWNER with your GitHub owner,
# LOWERCASED — an OCI repository name may not contain capitals, so the workflow
# lowercases it when publishing and this must match.
APP_IMAGE=ghcr.io/owner/submissions-checker
# `main` tracks the default branch and is what Watchtower follows.
# To roll back, pin an immutable build: APP_IMAGE_TAG=sha-abc1234 (and stop watchtower).
APP_IMAGE_TAG=main
APP_REPLICAS=2
# Seconds between registry polls.
WATCHTOWER_INTERVAL=60
# Directory holding the host's registry credentials, for a PRIVATE GHCR package.
# Create with: docker login ghcr.io -u <user> --password-stdin  (token: read:packages)
# If the package is public, this can stay as-is; the mounted config is simply unused.
DOCKER_CONFIG_DIR=/root/.docker

# --- Check sandbox bounds ----------------------------------------------------
# Ceiling on what a subject's config.yml may request. A subject asking for more is
# clamped to these values and the clamp is logged. Sized against the memory budget in
# docker-compose.prod.yml: roughly 500MB is left unspent for a transient sandbox.
SANDBOX_MAX_MEMORY=384m
SANDBOX_MAX_CPUS=1.0

# --- Compose profiles (opt-in features) ----------------------------------------
# Comma-joined list of profiles to turn on. Set it in exactly ONE place — this is that
# place; do not add a second COMPOSE_PROFILES= line further down in this file, since
# compose reads a plain .env file top-to-bottom and a later line silently wins over
# this one, overriding it rather than adding to it.
#   backup        — off-host database + bucket backups to Google Drive, see below
#   observability — Alloy metrics pushed to Grafana Cloud, see below
# Enable neither, either, or both (comma-joined):
# COMPOSE_PROFILES=observability,backup

# --- Backups (opt-in) ---------------------------------------------------------
# Off unless the `backup` profile is enabled above — a copy on this disk would die
# with the disk, so backups go only to an off-host rclone remote. Full setup and
# restore instructions: docs/deployment.md#backups-and-restore.
#
# rclone remote as "name:path", e.g. a Drive remote named "gdrive". A value with no
# colon is refused at startup — it would mean writing "backups" onto this same host.
RCLONE_REMOTE=gdrive:subchk
# Directory on the HOST holding rclone.conf (gitignored; created with `rclone config`
# on your own machine, then copied here). Mounted read-write: rclone rewrites its
# Google token into this file whenever it refreshes.
RCLONE_CONFIG_DIR=./docker/backup/rclone
# Cron schedule (busybox crond) and timezone the container's clock uses to evaluate it.
BACKUP_CRON=0 */6 * * *
BACKUP_TZ=Europe/Kyiv
# Dumps and mirror snapshots older than this are pruned — but only after a run that
# succeeded end-to-end; a failing backup never deletes the last good one.
BACKUP_RETENTION_DAYS=30

# --- AI provider (optional; AI review is skipped when unset) ------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
ANTHROPIC_API_KEY=

# --- Email (optional; notifications are skipped when unset) -------------------
# Configure exactly ONE of the three blocks below. Each channel is enabled
# independently by the presence of its key, so setting two sends every notification
# twice.
#
# Choosing between them comes down to what you can prove you own:
#
#   Resend  — verifies a DOMAIN, which needs MX plus SPF and DKIM TXT records.
#             A DuckDNS or similar free subdomain cannot satisfy that and will
#             never verify. Until a domain is verified, the API returns 403 and
#             only delivers to the Resend account owner's own address.
#   Brevo   — verifies a SINGLE SENDER ADDRESS by emailing you a link. No DNS at
#             all, so this is the one that works without owning a domain.
#   SMTP    — any mailbox you already have. Watch the provider's daily send limit.

RESEND_API_KEY=
# Must be on a domain verified at resend.com/domains.
RESEND_FROM_ADDRESS=noreply@example.edu

# BREVO_API_KEY=
# Must be an address verified under Senders in the Brevo dashboard.
# BREVO_FROM_ADDRESS=you@example.com

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=you@example.com
# SMTP_USE_TLS=true

# --- Air-raid pause ----------------------------------------------------------
# Lets a student pause a timed quiz when an air-raid alert is active over their
# location. Request a token at https://alerts.in.ua/api-request — they email it
# to you rather than issuing it on the spot, so allow for a wait; API reference
# is at https://devs.alerts.in.ua.
# Leave it blank to keep the feature off: with no token the button reports
# that the check is unavailable and no attempt is ever paused, because an
# unverified claim must not stop a graded clock.
#
# Geolocation is only exposed by browsers on a secure context, so this needs the
# HTTPS front end (Caddy) to be working — it will silently do nothing over
# plain HTTP.
ALERTS_IN_UA_TOKEN=
# AIR_RAID_PAUSE_ENABLED=true
# Upstream allows roughly 12 requests/minute per IP and responses are national,
# so one cached response serves every student. Two app replicas at 30s is 4/min.
# AIR_RAID_CACHE_SECONDS=30

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO

# --- Metrics to Grafana Cloud (optional) --------------------------------------
# Alloy scrapes both replicas over the compose network and pushes outbound; no port is
# opened. Enabled by the `observability` profile in COMPOSE_PROFILES above — leave that
# unset and nothing here changes. Values: grafana.com -> your stack -> Prometheus ->
# "Send Metrics". USER is the numeric instance id; TOKEN is an access-policy token with
# the metrics:write scope. See docs/observability.md.
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_PROM_TOKEN=
SUBCHK_ENV=prod

# --- Logs to Grafana Cloud (optional) -----------------------------------------
# Same Alloy, same `observability` profile: it also tails every container's stdout
# over the read-only Docker socket and pushes to Grafana Cloud Loki. URL is the
# stack's Loki push endpoint (…/loki/api/v1/push); USER is the numeric Loki user id;
# TOKEN is an access-policy token with the logs:write scope. See docs/observability.md.
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_LOKI_TOKEN=

# --- Added 2026-09-17 -----------------------------------------------------------
# Login / forgot-password throttling, per replica (10 failures per 15 minutes).
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_WINDOW_SECONDS=900
# Outbox messages handled per 10 s poll. Keep >1: at 1, a few failing email
# retries delay every check by minutes.
# OUTBOX_BATCH_SIZE=20
# Deadline reminder emails to students with no submission. OFF unless set: the
# first run mails everyone with an unsubmitted assignment due within the window.
# DEADLINE_REMINDERS_ENABLED=false
# DEADLINE_REMINDER_DAYS_BEFORE=2
# DEADLINE_REMINDER_INTERVAL=3600
